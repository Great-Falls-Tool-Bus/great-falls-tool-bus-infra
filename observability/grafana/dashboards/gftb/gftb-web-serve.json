          "legendFormat": "desired",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=\"$deployment\"}",
          "legendFormat": "ready",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
