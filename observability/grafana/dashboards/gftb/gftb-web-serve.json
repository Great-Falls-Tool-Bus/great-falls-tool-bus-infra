          "refId": "C",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_updated{namespace=\"$namespace\", deployment=\"$deployment\"}",
          "legendFormat": "updated",
          "range": true,
          "instant": false,
          "refId": "D",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
