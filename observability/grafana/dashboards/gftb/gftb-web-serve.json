    {
      "id": 11,
      "type": "timeseries",
      "title": "Container restarts per hour",
      "description": "Hourly restart increase per container. Any sustained non-zero line is a crashloop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-mail"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])",
          "legendFormat": "{{pod}} / {{container}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
