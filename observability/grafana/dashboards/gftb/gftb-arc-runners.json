    {
      "id": 17,
      "type": "stat",
      "title": "GFTB runner memory limit",
      "description": "Per-runner memory limit for the GFTB scale set. PR #105 restored the bounded site-build envelope at 16 GiB (17179869184 bytes). Reads 0 while no GFTB runner is live (min 0).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-mail"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"arc-runners\", resource=\"memory\", container=\"runner\", pod=~\"great-falls-tool-bus-nix-.*-runner-.*\"}) or on() vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
