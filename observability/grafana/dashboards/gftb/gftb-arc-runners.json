  "description": "Great Falls Tool Bus ARC runner scale set on the shared honey substrate: great-falls-tool-bus-nix (registration identity; workflows use runs-on tinyland-nix), compared against the shared tinyland-nix set. Covers utilisation, queue pressure proxies and the PR #105 16 GiB memory envelope. Source of truth: great-falls-tool-bus-infra observability/grafana/dashboards/gftb (TIN-3896).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Scale set utilisation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "great-falls-tool-bus-nix runners",
      "description": "Live runner pods for the GFTB scale set. Capacity posture is min 0 / max 4 (AGENTS.md, TIN-2165/TIN-2234): 0 is the expected idle value, 4 is saturation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-mail"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "count(kube_pod_info{namespace=\"arc-runners\", pod=~\"great-falls-tool-bus-nix-.*-runner-.*\"}) or on() vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
