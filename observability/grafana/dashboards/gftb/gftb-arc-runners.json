          "editorMode": "code",
          "expr": "(count(kube_pod_info{namespace=\"arc-runners\", pod=~\"great-falls-tool-bus-nix-.*-runner-.*\"}) or on() vector(0)) / clamp_min(count(kube_pod_info{namespace=\"arc-runners\", pod=~\".*-runner-.*\"}) or on() vector(0), 1)",
