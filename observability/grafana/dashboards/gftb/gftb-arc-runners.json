    {
      "id": 7,
      "type": "timeseries",
      "title": "Runner pods per scale set",
      "description": "Scale set is derived from the pod name via label_replace, because kube-state-metrics label metrics (kube_pod_labels) are not enabled on this cluster. Pattern: <scaleset>-<5-char-hash>-runner-<id>.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-mail"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "count by (scaleset) (label_replace(kube_pod_info{namespace=\"arc-runners\", pod=~\".*-runner-.*\"}, \"scaleset\", \"$1\", \"pod\", \"^(.*)-[a-z0-9]{5}-runner-.*$\"))",
          "legendFormat": "{{scaleset}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Live runner pods",
      "description": "Current runner pods by scale set and node. GFTB rows appear only while a GFTB job holds a runner (min 0).",
