          "editorMode": "code",
          "expr": "count by (scaleset, node) (label_replace(kube_pod_info{namespace=\"arc-runners\", pod=~\".*-runner-.*\"}, \"scaleset\", \"$1\", \"pod\", \"^(.*)-[a-z0-9]{5}-runner-.*$\"))",
          "legendFormat": "__auto",
