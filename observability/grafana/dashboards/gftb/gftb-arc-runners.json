    {
      "id": 12,
      "type": "stat",
      "title": "p95 runner ready latency",
      "description": "Seconds from pod start to Ready, p95 across live runner pods. This is a proxy for job wait time, not job wait time itself: the true job-queued-to-job-started interval is a GitHub-side signal and is not exported (see the gap panel).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-mail"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-mail"
          },
          "editorMode": "code",
          "expr": "quantile(0.95, kube_pod_status_ready_time{namespace=\"arc-runners\"} - on (namespace, pod) kube_pod_start_time{namespace=\"arc-runners\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
