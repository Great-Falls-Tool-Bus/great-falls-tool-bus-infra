], allow_empty = True)

CORE_CHECKOUT_CONTRACT_SOURCES = [
    "Justfile",
    "MODULE.bazel",
    "README.md",
    "config/organization.yaml",
    "docs/ci-credentials.md",
    "docs/runbooks/oncluster-web-cutover.md",
] + WORKFLOW_SOURCES

sh_test(
    name = "core_checkout_contract_test",
    srcs = ["scripts/validate-core-checkout.py"],
    data = CORE_CHECKOUT_CONTRACT_SOURCES,
)

sh_test(
    name = "core_checkout_contract_selftest",
    srcs = ["scripts/validate-core-checkout.py"],
    args = ["--self-test"],
    data = CORE_CHECKOUT_CONTRACT_SOURCES,
)

